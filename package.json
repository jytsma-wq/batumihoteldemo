{
  "name": "small-hotels-batumi-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:all": "node scripts/check-i18n.mjs --all",
    "check:content": "node scripts/check-content-i18n.mjs",
    "check:content:all": "node scripts/check-content-i18n.mjs --all",
    "check:runtime-i18n": "node scripts/check-runtime-i18n.mjs",
    "check:source": "node scripts/check-source-copy.mjs",
    "check:render": "node scripts/check-render.mjs",
    "prebuild": "npm run check:i18n && npm run check:content && npm run check:runtime-i18n && npm run check:source && npm run check:render",
    "build": "vite build && node scripts/prerender.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify:locales": "npm run check:i18n:all && npm run check:content:all && npm run build && npm run check:dist",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.1"
  }
}
